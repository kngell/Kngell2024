{
  "Dashboard": {
    "link": "/admin/admin/index",
    "icon": {
      "name": "icon-dashboard",
      "aria": "Icon Dashboard",
      "class": ["home"]
    },

    "type": "regular"
  },
  "Contact": {
    "link": "/contact/index",
    "icon": "icon-email",
    "type": "regular"
  },
  "Product": {
    "type": "dropdown",
    "icon-left": {
      "name": "icon-shopping-bag",
      "aria": "Product Icon",
      "class": ["product-icon"]
    },
    "icon-right": {
      "name": "icon-arrow-down",
      "aria": "DropDown Items",
      "class": ["arrow-down", "rotated"]
    },

    "link": "",
    "dropdown-items": {
      "Product List": "/admin/admin/product-list",
      "Add Product": "/admin/admin/product-add"
    }
  },

  "Pages": {
    "type": "dropdown",
    "icon-left": {
      "name": "icon-checklist",
      "aria": "Page Icon",
      "class": ["page-icon"]
    },
    "icon-right": {
      "name": "icon-arrow-down",
      "aria": "DropDown Items",
      "class": ["arrow-down", "rotated"]
    },
    "link": "",
    "dropdown-items": {
      "Category New": "/admin/category-page/add",
      "Category List": "/admin/category-list/index",
      "Hero New": "/admin/content-block-page/add/hero_section",
      "Hero List": "/admin/content-block-list/index/hero_section",
      "Edit Hero": "/admin/content-block-page/*/edit/hero_section",
      "Banner List": "/admin/content-block-list/index/small_banner",
      "Small Banner": "/admin/content-block-page/add/small_banner",
      "Edit Banner": "/admin/content-block-page/*/edit/small_banner",
      "Big Banner": "/admin/content-block-page/add/big_banner",
      "Big Banner List": "/admin/content-block-list/index/big_banner",
      "Summer Banner New": "/admin/content-block-page/add/summer_banner",
      "Summer Banner List": "/admin/content-block-list/index/summer_banner",
      "Edit Summer Banner": "/admin/content-block/*/edit/summer_banner"
    }
  },
  "Calendar": {
    "link": "/admin/admin/calendar",
    "icon": "icon-calendar",
    "type": "regular"
  },
  "Profile": {
    "link": "/admin/admin/calendar",
    "icon": "icon-person",
    "type": "regular"
  }
}
